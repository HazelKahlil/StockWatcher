# Public metadata only. Never put Tushare Token, passwords or master keys here.
DOMAIN=stock.hazelkahlil.com
ACME_EMAIL=unused@localhost.invalid

IMAGE_TAG=web-internal-test-v1-REPLACE_WITH_COMMIT
BUILD_VERSION=web-internal-test-v1-REPLACE_WITH_COMMIT
SOURCE_COMMIT=REPLACE_WITH_FINAL_40_CHAR_COMMIT
UV_VERSION=0.9.26

SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=120
LOG_LEVEL=INFO
TUNNEL_ORIGIN_PORT=18000

# Local-only Cloudflare values. Copy this file to .env.tunnel and fill there.
CLOUDFLARED_TUNNEL_ID=REPLACE_WITH_TUNNEL_UUID
CLOUDFLARED_CREDENTIALS_FILE=/absolute/path/to/tunnel-credentials.json
TUNNEL_RUN_UID=REPLACE_WITH_ID_U
TUNNEL_RUN_GID=REPLACE_WITH_ID_G
