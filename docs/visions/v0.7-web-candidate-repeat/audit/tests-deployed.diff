+            "172.20.0.5",
+            ("172.16.0.0/12",),
+        )
+        == "172.20.0.5"
+    )
+
+    limiter = RateLimiter(max_attempts=2, window_seconds=60, max_keys=2)
+    limiter.record_failure("first")
+    limiter.record_failure("second")
+    with pytest.raises(AuthError) as bounded:
