+    calls: list[str] = []
+
+    class Outbox:
+        def prune(self, **_: object) -> int:
+            calls.append("outbox")
+            return 0
+
+    class Secrets:
+        def expire_requests(self, **_: object) -> int:
+            calls.append("secret-expiry")
+            return 0
+
