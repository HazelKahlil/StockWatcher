+    assert trusted_client_ip(spoofed, "198.51.100.9", ()) == "198.51.100.9"
+    assert (
+        trusted_client_ip(spoofed, "172.20.0.5", ("172.16.0.0/12",))
+        == "203.0.113.7"
+    )
+    assert (
+        trusted_client_ip(
